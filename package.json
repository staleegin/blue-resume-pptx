{
  "name": "blue-resume-pptx",
  "version": "1.0.0",
  "description": "单页 A4 简历 PPT 生成器：JSON 数据 → 可编辑 .pptx（蓝色顶栏 + 左栏经历 + 右栏卡片版式），附 Claude 技能",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node skill/blue-resume-pptx/scripts/build_resume.js",
    "example": "node skill/blue-resume-pptx/scripts/build_resume.js examples/zh_campus.json examples/zh_campus.pptx",
    "test": "node tests/bold.test.js && node tests/docs_sync.test.js",
    "test:parity": "python3 tests/parity.py examples/zh_campus.json examples/en_marketing.json",
    "sync-docs": "sh tools/sync_docs.sh"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=18"
  }
}
